# Cartographer 3D (USB). 1d50:614e is the generic Klipper USB id shared by many boards,
# so the manufacturer string is required to only match the Cartographer.
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="614e", ATTRS{manufacturer}=="Cartographer", ACTION=="add", SYMLINK+="cartographer", RUN+="@RATOS_SCRIPTS@/klipper-mcu-added.sh"
